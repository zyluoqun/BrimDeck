{
  "manifest_version": 3,
  "name": "BrimDeck Chart Window",
  "version": "1.3.0",
  "description": "Open or activate your OpenMarket chart window for BrimDeck.",
  "minimum_chrome_version": "120",
  "permissions": ["nativeMessaging", "storage", "alarms", "scripting"],
  "host_permissions": ["https://openmarket.xyz/*"],
  "background": { "service_worker": "background.mjs", "type": "module" },
  "key": ""
}
